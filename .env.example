# Copie ce fichier en .env.local puis renseigne les valeurs de ton projet Supabase
# (Supabase > Project Settings > API). Sans ces variables, l'app fonctionne en mode démo local.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ta-cle-anon-publique

# Uniquement pour publier volontairement une démo sur Vercel (sans Supabase).
# Sans cette ligne, un déploiement Vercel sans les deux variables ci-dessus est refusé.
# VITE_ALLOW_DEMO=1
